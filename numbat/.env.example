# Standalone dev configuration — copy to numbat/.env (gitignored).
# Under the Supervisor none of this is needed: the add-on gets its connection
# and timezone from the Supervisor, and the config UI writes /data/numbat-config.json.

# Home Assistant connection (long-lived access token: HA profile -> Security)
NUMBAT_HA_URL=http://homeassistant.local:8123
NUMBAT_HA_TOKEN=

# Local timezone (IANA name). Anchors the learned load buckets, the daily SoC
# target and vacation end times; without it (or TZ in the environment) Numbat
# runs in UTC and every local-time feature is shifted by your UTC offset.
NUMBAT_TZ=Australia/Adelaide

# Optional overrides
#NUMBAT_LOG_LEVEL=debug
#NUMBAT_CONFIG_FILE=./numbat-config.json
